# Public client configuration. These values are embedded in the browser bundle.
# Leave blank for the Vercel founder review (same-origin /api/leads).
# For GoDaddy, set the stable HTTPS URL of the separately deployed lead API.
VITE_LEAD_API_URL=

# Supply only the verified public HTTPS booking-calendar link.
VITE_BOOKING_CALENDAR_URL=

# Optional, public analytics identifiers. Provider scripts remain blocked until
# the visitor accepts analytics. Leave every value blank to disable analytics.
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=

# JSON object mapping event names to LinkedIn conversion IDs. Example shape:
# {"audit_form_success":"CONVERSION_ID","calendar_booked":"CONVERSION_ID"}
VITE_LINKEDIN_CONVERSION_IDS_JSON=

# Development defaults to analytics logging. Set false to silence it. Production
# defaults to no logging unless explicitly set to true for a controlled debug run.
VITE_ANALYTICS_DEBUG=false

# CRO experiments are dormant unless both approval and one valid experiment ID
# are supplied. Activate only one major funnel experiment at a time.
VITE_CRO_APPROVED=false
VITE_CRO_ACTIVE_EXPERIMENT_ID=
VITE_CRO_TREATMENT_PERCENT=50

# Exclude development/internal hostnames from assignment and experiment context.
# A visit with ?cro_internal=1 is also excluded for that browser session.
VITE_CRO_EXCLUDED_HOSTNAMES=localhost,127.0.0.1
VITE_CRO_INCLUDE_AUTOMATION=false

# Development/test-only visual QA override: control or treatment. It never emits
# experiment analytics context and is ignored in production builds.
VITE_CRO_PREVIEW_VARIANT=

# Server-only lead delivery. Never prefix these values with VITE_.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_BEARER_TOKEN=
LEAD_ALLOWED_ORIGINS=https://digitaluniversepro.co

# Optional server hardening and tuning.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000
LEAD_RATE_LIMIT_SALT=
LEAD_WEBHOOK_TIMEOUT_MS=8000

# Server-side experiment gate. These must match the approved public experiment
# before the revenue-field treatment may omit monthlyRevenue.
CRO_EXPERIMENT_APPROVED=false
CRO_ACTIVE_EXPERIMENT_ID=
